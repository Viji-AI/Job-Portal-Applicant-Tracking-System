# Spring Boot reads these as environment variables (see application.yml).
# Copy this file to `.env` for your own reference, then export these
# in your shell, your IDE run config, or a tool like `direnv` before
# running the app. Spring Boot does NOT auto-load a .env file by default.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_portal
DB_USERNAME=root
DB_PASSWORD=yourpassword

SERVER_PORT=5000

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string

JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

CLIENT_URL=http://localhost:5173
